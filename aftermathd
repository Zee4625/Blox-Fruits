end, "Color for player ESP")

WC:ColorPicker("Weapon Color", "ColWeapon", Color3.fromRGB(0, 150, 255), 0, function(col)
    for _, d in pairs(trackedWeapons) do
        d.rarity.color = col
    end
end, "Color for weapon ESP")

