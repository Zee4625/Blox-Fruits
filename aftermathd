-- ========== UPDATE LOOP ==========

local frame = 0
RunService.Heartbeat:Connect(function()
    frame = frame + 1
    if frame % 3 ~= 0 then return end

    for player, d in pairs(trackedPlayers) do
        updatePlayerESP(player, d)
    end

    for part, d in pairs(trackedWeapons) do
        if not part or not part.Parent then
            removeWeaponESP(part)
        else
            updateWeaponESP(part, d)
        end
    end
end)

Library:Notification("ZeeHub", "ESP loaded! All OFF by default.", 5)
