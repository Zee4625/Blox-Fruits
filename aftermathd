    ESP.Weapons = state
    if not state then
        for _, d in pairs(trackedWeapons) do
            if not d.isStatic then d.label.Visible = false end
        end
    end
end)

WeaponsSection:Toggle("Ground Weapons", "EspStatic", false, "ESP on ground weapons", function(state)
    ESP.StaticWeapons = state
    if not state then
        for _, d in pairs(trackedWeapons) do
            if d.isStatic then d.label.Visible = false end
        end
    end
end)

