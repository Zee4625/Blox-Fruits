-- ESP Script cu GUI Toggle
-- Arme (rarity) + Jucători + Mașini

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- ========== CONFIG ==========
local ESP = {
    Players = true,
    Weapons = true,
    StaticWeapons = true,
    Vehicles = true,
}

local RARITY = {
    ["BerettaM9"] = { color = Color3.fromRGB(255, 165, 0),   label = "⭐ BerettaM9 [Legendary]" },
    ["SigSaur"]   = { color = Color3.fromRGB(255, 165, 0),   label = "⭐ SigSaur [Legendary]" },
    ["Mp5"]       = { color = Color3.fromRGB(150, 0, 255),   label = "💜 MP5 [Rare]" },
    ["DEFAULT"]   = { color = Color3.fromRGB(200, 200, 200), label = "⬜ Weapon [Common]" },
}

local function getRarity(name)
    for key, data in pairs(RARITY) do
        if key ~= "DEFAULT" and name:find(key) then
            return data
        end
    end
    return RARITY["DEFAULT"]
end

local trackedWeapons = {}
local trackedPlayers = {}
local trackedVehicles = {}  -- cheia = model parinte al masinii

-- ========== GUI ==========
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ESPGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.Parent = localPlayer.PlayerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 220, 0, 215)
frame.Position = UDim2.new(0, 20, 0.5, -107)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 35)
title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
title.Text = "👁  ESP Menu"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 15
title.Font = Enum.Font.GothamBold
title.Parent = frame
Instance.new("UICorner", title).CornerRadius = UDim.new(0, 8)

local function createToggle(text, yPos, stateKey, offAction)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 36)
    btn.Position = UDim2.new(0.06, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
    btn.Text = text .. "  ON"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    btn.MouseButton1Click:Connect(function()
        ESP[stateKey] = not ESP[stateKey]
        local on = ESP[stateKey]
        btn.BackgroundColor3 = on and Color3.fromRGB(0, 180, 80) or Color3.fromRGB(180, 40, 40)
        btn.Text = text .. (on and "  ON" or "  OFF")
        if not on and offAction then offAction() end
    end)
end

createToggle("👤 Player ESP",       45,  "Players")
createToggle("🔵 Weapon ESP (Hold)", 90,  "Weapons")
createToggle("🗺  Static Weapons",   135, "StaticWeapons")
createToggle("🚗 Vehicle ESP",       180, "Vehicles", function()
    for model, data in pairs(trackedVehicles) do
        pcall(function() data.highlight.Enabled = false end)
        pcall(function() data.billboard.Enabled = false end)
    end
end)

-- ========== VEHICLE ESP ==========

local function getVehicleModel(part)
    -- CollisionHelper e deep in model, urcam pana gasim un Model cu Humanoid sau PrimaryPart
    local current = part.Parent
    while current and current ~= workspace do
        if current:IsA("Model") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function isCollisionHelper(part)
    if not part:IsA("MeshPart") then return false end
    if part.Name ~= "CollisionHelper" then return false end
    if not part:IsDescendantOf(workspace) then return false end
    -- Verifica WeldConstraint + SurfaceAppearance BaseColor
    local hasWeld = false
    local hasSkin = false
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("WeldConstraint") then hasWeld = true end
        if child:IsA("SurfaceAppearance") and child.Name == "BaseColor" then hasSkin = true end
    end
    return hasWeld and hasSkin
end

local function createVehicleESP(model)
    if trackedVehicles[model] then return end

    -- Gaseste un part central
    local root = model:FindFirstChildWhichIsA("BasePart", true)
    if not root then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 220, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 220, 0)
    highlight.FillTransparency = 0.75
    highlight.OutlineTransparency = 0
    highlight.Adornee = model
    highlight.Parent = workspace

    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 160, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Adornee = root
    billboard.Parent = workspace

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = "🚗 " .. model.Name
    label.TextColor3 = Color3.fromRGB(255, 220, 0)
    label.TextStrokeTransparency = 0
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    trackedVehicles[model] = { highlight = highlight, billboard = billboard, root = root }
end

local function removeVehicleESP(model)
    if trackedVehicles[model] then
        pcall(function() trackedVehicles[model].highlight:Destroy() end)
        pcall(function() trackedVehicles[model].billboard:Destroy() end)
        trackedVehicles[model] = nil
    end
end

-- ========== PLAYER ESP ==========

local function createPlayerESP(player)
    if player == localPlayer then return end
    if trackedPlayers[player] then return end

    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 160, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.Parent = workspace

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextColor3 = Color3.fromRGB(255, 50, 50)
    label.TextStrokeTransparency = 0
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 50, 50)
    highlight.OutlineColor = Color3.fromRGB(255, 50, 50)
    highlight.FillTransparency = 0.7
    highlight.OutlineTransparency = 0
    highlight.Parent = workspace

    trackedPlayers[player] = { billboard = billboard, label = label, highlight = highlight }
end

local function removePlayerESP(player)
    if trackedPlayers[player] then
        pcall(function() trackedPlayers[player].billboard:Destroy() end)
        pcall(function() trackedPlayers[player].highlight:Destroy() end)
        trackedPlayers[player] = nil
    end
end

-- ========== WEAPON ESP ==========

local function isStaticWeapon(part)
    if not part:IsA("MeshPart") then return false end
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("SurfaceAppearance") then return true end
    end
    return false
end

local function isHeldWeapon(part)
    return part.Name == "Handle" and part.Material == Enum.Material.SmoothPlastic
end

local function createWeaponESP(part, rarity)
    if trackedWeapons[part] then return end
    local myChar = localPlayer.Character
    if myChar and part:IsDescendantOf(myChar) then return end

    local box = Instance.new("SelectionBox")
    box.Adornee = part
    box.Color3 = rarity.color
    box.LineThickness = 0.04
    box.SurfaceTransparency = 0.6
    box.SurfaceColor3 = rarity.color
    box.Parent = part

    local billboard = Instance.new("BillboardGui")
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 200, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.Adornee = part
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.Text = rarity.label
    label.TextColor3 = rarity.color
    label.TextStrokeTransparency = 0
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    trackedWeapons[part] = { box = box, gui = billboard }
end

local function removeWeaponESP(part)
    if trackedWeapons[part] then
        pcall(function() trackedWeapons[part].box:Destroy() end)
        pcall(function() trackedWeapons[part].gui:Destroy() end)
        trackedWeapons[part] = nil
    end
end

local function checkPart(part)
    if isCollisionHelper(part) then
        local model = getVehicleModel(part)
        if model then createVehicleESP(model) end
    elseif isStaticWeapon(part) and not isCollisionHelper(part) then
        createWeaponESP(part, getRarity(part.Name))
    elseif isHeldWeapon(part) then
        createWeaponESP(part, getRarity(part.Name))
    end
end

-- ========== UPDATE LOOP ==========

RunService.Heartbeat:Connect(function()
    local myChar = localPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

    -- Players
    for player, data in pairs(trackedPlayers) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local show = ESP.Players and root ~= nil
        data.billboard.Enabled = show
        data.highlight.Enabled = ESP.Players and char ~= nil
        if root then
            data.highlight.Adornee = char
            data.billboard.Adornee = root
            data.label.Text = "🔴 " .. player.Name
        end
    end

    -- Vehicles
    for model, data in pairs(trackedVehicles) do
        if not model or not model.Parent then
            removeVehicleESP(model)
            continue
        end
        data.highlight.Enabled = ESP.Vehicles
        data.billboard.Enabled = ESP.Vehicles
    end

    -- Weapons
    for part, data in pairs(trackedWeapons) do
        if not part or not part.Parent then
            removeWeaponESP(part)
            continue
        end
        if myChar and part:IsDescendantOf(myChar) then
            removeWeaponESP(part)
            continue
        end
        local isStatic = isStaticWeapon(part)
        local show = (isStatic and ESP.StaticWeapons) or (not isStatic and ESP.Weapons)
        data.box.Visible = show
        data.gui.Enabled = show
    end
end)

-- ========== SCAN & EVENTS ==========

for _, part in ipairs(workspace:GetDescendants()) do
    pcall(checkPart, part)
end

workspace.DescendantAdded:Connect(function(part)
    task.wait(0.05)
    pcall(checkPart, part)
end)

workspace.DescendantRemoving:Connect(function(part)
    removeWeaponESP(part)
    -- Dacă e model de masina
    removeVehicleESP(part)
end)

for _, player in ipairs(Players:GetPlayers()) do
    createPlayerESP(player)
end

Players.PlayerAdded:Connect(function(player)
    task.wait(0.5)
    createPlayerESP(player)
end)

Players.PlayerRemoving:Connect(function(player)
    removePlayerESP(player)
end)

print("[ESP] Gata! 👤 Players | 🔵 Weapons | 🚗 Vehicles")
