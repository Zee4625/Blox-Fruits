local ok, lib = pcall(function()
    return loadstring(game:HttpGet("https://raw.githubusercontent.com/Vovabro46/trash/refs/heads/main/Aurora.lua"))()
end)

if not ok then
    warn("Aurora failed to load: " .. tostring(lib))
    return
end

Library = lib

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ESP = {
    Players = false,
    Weapons = false,
    StaticWeapons = false,
    PlayerColor = Color3.fromRGB(255, 50, 50),
    MaxDistance = 400,
}

local RARITY = {
    ["BerettaM9"] = { color = Color3.fromRGB(255, 165, 0),   label = "BerettaM9 [Leg]" },
    ["SigSaur"]   = { color = Color3.fromRGB(255, 165, 0),   label = "SigSaur [Leg]"   },
    ["Mp5"]       = { color = Color3.fromRGB(150, 0, 255),   label = "MP5 [Rare]"       },
    ["DEFAULT"]   = { color = Color3.fromRGB(200, 200, 200), label = "Weapon"           },
}

local function getRarity(name)
    for k, v in pairs(RARITY) do
        if k ~= "DEFAULT" and name:find(k) then return v end
    end
    return RARITY["DEFAULT"]
end

local trackedPlayers = {}
local trackedWeapons = {}

-- ========== DRAWING ==========

local function newText()
    local d = Drawing.new("Text")
    d.Visible = false
    d.Center = true
    d.Outline = true
    d.OutlineColor = Color3.fromRGB(0, 0, 0)
    d.Size = 13
    d.Font = Drawing.Fonts.GothamSemibold
    return d
end

local function newLine()
    local d = Drawing.new("Line")
    d.Visible = false
    d.Thickness = 1
    return d
end

-- ========== HELPERS ==========

local function getMyRoot()
    local c = localPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function w2s(pos)
    local ok2, sp, onScreen = pcall(function()
        return camera:WorldToViewportPoint(pos)
    end)
    if not ok2 then return nil end
    if not onScreen or sp.Z <= 0 then return nil end
    return Vector2.new(sp.X, sp.Y)
end

-- ========== PLAYER ESP ==========

local function createPlayerESP(player)
    if player == localPlayer or trackedPlayers[player] then return end
    trackedPlayers[player] = {
        name   = newText(),
        tracer = newLine(),
    }
end

local function removePlayerESP(player)
    if not trackedPlayers[player] then return end
    pcall(function() trackedPlayers[player].name:Remove() end)
    pcall(function() trackedPlayers[player].tracer:Remove() end)
    trackedPlayers[player] = nil
end

local function updatePlayerESP(player, d)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local myRoot = getMyRoot()

    if not root or not myRoot then
        d.name.Visible   = false
        d.tracer.Visible = false
        return
    end

    local dist = (myRoot.Position - root.Position).Magnitude

    if not ESP.Players or dist > ESP.MaxDistance then
        d.name.Visible   = false
        d.tracer.Visible = false
        return
    end

    local sp = w2s(root.Position)
    if not sp then
        d.name.Visible   = false
        d.tracer.Visible = false
        return
    end

    local vp = camera.ViewportSize

    d.name.Visible   = true
    d.name.Position  = Vector2.new(sp.X, sp.Y - 20)
    d.name.Text      = player.Name .. " [" .. math.floor(dist) .. "m]"
    d.name.Color     = ESP.PlayerColor

    d.tracer.Visible = true
    d.tracer.From    = Vector2.new(vp.X / 2, vp.Y)
    d.tracer.To      = sp
    d.tracer.Color   = ESP.PlayerColor
end

-- ========== WEAPON ESP ==========

local function isStaticWeapon(part)
    if not part:IsA("MeshPart") then return false end
    for _, c in ipairs(part:GetChildren()) do
        if c:IsA("SurfaceAppearance") then return true end
    end
    return false
end

local function isHeldWeapon(part)
    return part.Name == "Handle" and part.Material == Enum.Material.SmoothPlastic
end

local function createWeaponESP(part, rarity, static)
    if trackedWeapons[part] then return end
    local myChar = localPlayer.Character
    if myChar and part:IsDescendantOf(myChar) then return end
    trackedWeapons[part] = {
        label    = newText(),
        rarity   = rarity,
        isStatic = static,
    }
end

local function removeWeaponESP(part)
    if not trackedWeapons[part] then return end
    pcall(function() trackedWeapons[part].label:Remove() end)
    trackedWeapons[part] = nil
end

local function updateWeaponESP(part, d)
    local myChar = localPlayer.Character
    if myChar and part:IsDescendantOf(myChar) then
        removeWeaponESP(part)
        return
    end

    local toggled = (d.isStatic and ESP.StaticWeapons) or (not d.isStatic and ESP.Weapons)
    local myRoot  = getMyRoot()
    local dist    = myRoot and (myRoot.Position - part.Position).Magnitude or math.huge

    if not toggled or dist > ESP.MaxDistance then
        d.label.Visible = false
        return
    end

    local sp = w2s(part.Position)
    if not sp then
        d.label.Visible = false
        return
    end

    d.label.Visible  = true
    d.label.Position = sp
    d.label.Text     = d.rarity.label .. " [" .. math.floor(dist) .. "m]"
    d.label.Color    = d.rarity.color
end

-- ========== SCAN ==========

local function checkPart(part)
    if isStaticWeapon(part) then
        createWeaponESP(part, getRarity(part.Name), true)
    elseif isHeldWeapon(part) then
        createWeaponESP(part, getRarity(part.Name), false)
    end
end

task.spawn(function()
    local list = workspace:GetDescendants()
    for i, part in ipairs(list) do
        pcall(checkPart, part)
        if i % 300 == 0 then task.wait() end
    end
end)

workspace.DescendantAdded:Connect(function(part)
    task.wait(0.1)
    pcall(checkPart, part)
end)

workspace.DescendantRemoving:Connect(function(part)
    removeWeaponESP(part)
end)

for _, p in ipairs(Players:GetPlayers()) do
    createPlayerESP(p)
end

Players.PlayerAdded:Connect(function(p)
    task.wait(0.5)
    createPlayerESP(p)
end)

Players.PlayerRemoving:Connect(function(p)
    removePlayerESP(p)
end)

