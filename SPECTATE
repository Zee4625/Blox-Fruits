local function getAccountAge(player)
	local age = player.AccountAge
	if age < 30 then
		return age .. " days  (NEW)"
	elseif age < 365 then
		return math.floor(age / 30) .. " months"
	else
		return math.floor(age / 365) .. " years " .. math.floor((age % 365) / 30) .. " mo"
	end
end

local function getMembership(player)
	local m = player.MembershipType
	if m == Enum.MembershipType.Premium then
		return "Roblox Premium"
	else
		return "None"
	end
end

local function getTeamName(player)
	if player.Team then return player.Team.Name end
	return "No Team"
end

local function getCharStats(player)
	local char = player.Character
	if not char then return nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum then return nil end
	return {
		health    = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth),
		walkspeed = tostring(hum.WalkSpeed),
		jumppower = tostring(hum.JumpPower),
		position  = root and
			("X:"..math.floor(root.Position.X)
			.." Y:"..math.floor(root.Position.Y)
			.." Z:"..math.floor(root.Position.Z))
			or "--",
		posY = root and math.floor(root.Position.Y) or 0,
	}
end

local function getFriendStatus(player)
	local ok, result = pcall(function()
		return LocalPlayer:IsFriendsWith(player.UserId)
	end)
	if ok and result then return "Friend" end
	return "Not a friend"
end

local function getJoinDate(player)
	-- Roblox does not expose account creation date in LocalScript.
	-- We can approximate from AccountAge relative to today.
	local age   = player.AccountAge
	local today = os.time()
	local stamp = today - (age * 86400)
	local d     = os.date("*t", stamp)
	return string.format("%04d-%02d-%02d (approx)", d.year, d.month, d.mday)
end

local function refreshInfoPanel(player)
	if not player then clearInfoPanel() return end

	UsernameLbl.Text    = "@" .. player.Name
	DisplayNameLbl.Text = player.DisplayName ~= player.Name
		and ("aka " .. player.DisplayName) or ""
	AvatarLbl.Text      = string.sub(player.Name, 1, 1):upper()

	infoValues["UserId"].Text    = tostring(player.UserId)
	infoValues["AccountAge"].Text = getAccountAge(player)
	infoValues["JoinDate"].Text   = getJoinDate(player)
	infoValues["Membership"].Text = getMembership(player)
	infoValues["Friend"].Text     = getFriendStatus(player)
	infoValues["Team"].Text       = getTeamName(player)
	infoValues["ServerID"].Text   = string.sub(game.JobId, 1, 18) .. "..."

	-- Premium highlight
	if player.MembershipType == Enum.MembershipType.Premium then
		infoValues["Membership"].TextColor3 = C.YELLOW
	else
		infoValues["Membership"].TextColor3 = C.WHITE
	end

	-- Location (country via LocalizationService, may not always work)
	local ok, country = pcall(function()
		return LocalizationService:GetCountryRegionForPlayerAsync(player)
	end)
	infoValues["Location"].Text = (ok and country and country ~= "") and country or "Unknown"

	local stats = getCharStats(player)
	if stats then
		infoValues["Health"].Text    = stats.health
		infoValues["WalkSpeed"].Text = stats.walkspeed
		infoValues["JumpPower"].Text = stats.jumppower
		infoValues["Position"].Text  = stats.position
	end

	-- Ping is only available for local player in Roblox
	local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	infoValues["Ping"].Text = ping .. " ms"

	-- FPS
	if #fpsBuffer > 0 then
		local sum = 0
		for _, v in ipairs(fpsBuffer) do sum = sum + v end
		infoValues["FPS"].Text = math.floor(sum / #fpsBuffer) .. " fps"
	end
end

