function stopSpectate()
	isSpectating    = false
	spectatingTarget = nil
	Camera.CameraType    = Enum.CameraType.Custom
	Camera.CameraSubject = LocalPlayer.Character
		and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") or nil
	StopBtnMain.Visible = false
	setStatus("Spectate stopped  |  Camera returned")
	showNotif("Spectate stopped", false)

	for _, v in pairs(liveStats) do v.Text = "--" end
end

local function spectatePlayer(player)
	if player == LocalPlayer then
		showNotif("Cannot spectate yourself", true)
		return
	end

	local char = player.Character
	if not char then
		showNotif("Player has no character", true)
		return
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then
		showNotif("Invalid character", true)
		return
	end

	isSpectating    = true
	spectatingTarget = player

	Camera.CameraType    = Enum.CameraType.Custom
	Camera.CameraSubject = hum
	selectedCam          = "Follow"

	StopBtnMain.Visible = true
	setStatus("Spectating: @" .. player.Name)
	showNotif("Spectating @" .. player.Name)

	-- Switch to spectate tab
	for _, t in ipairs(tabs) do
		local data = tabBtns[t]
		local isSelected = (t == "SPECTATE INFO")
		tween(data.btn, {TextColor3 = isSelected and C.NEON or C.MUTED}, 0.15)
		data.stroke.Color = isSelected and C.NEON or C.NEON_DARK
	end
	currentTab = "spectate"
	PlayersTab.Visible  = false
	SpectateTab.Visible = true
	ServerTab.Visible   = false
	SettingsTab.Visible = false
end

