-- Helper: create a stat block
local function makeStatBlock(parent, posX, label)
	local block = Instance.new("Frame")
	block.Size             = UDim2.new(0, 72, 1, -10)
	block.Position         = UDim2.new(0, posX, 0, 5)
	block.BackgroundColor3 = NEON_GREEN_DARK
	block.BorderSizePixel  = 0
	block.Parent           = parent

	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 5)
	bc.Parent = block

	local bs = Instance.new("UIStroke")
	bs.Color     = NEON_GREEN_DIM
	bs.Thickness = 1
	bs.Parent    = block

	local lbl = Instance.new("TextLabel")
	lbl.Size              = UDim2.new(1, 0, 0.48, 0)
	lbl.Position          = UDim2.new(0, 0, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text              = label
	lbl.TextColor3        = TEXT_DIM
	lbl.TextSize          = 10
	lbl.Font               = Enum.Font.GothamBold
	lbl.TextXAlignment    = Enum.TextXAlignment.Center
	lbl.Parent            = block

	local val = Instance.new("TextLabel")
	val.Name              = "Value"
	val.Size              = UDim2.new(1, 0, 0.52, 0)
	val.Position          = UDim2.new(0, 0, 0.48, 0)
	val.BackgroundTransparency = 1
	val.Text              = "--"
	val.TextColor3        = NEON_GREEN
	val.TextSize          = 13
	val.Font               = Enum.Font.GothamBold
	val.TextXAlignment    = Enum.TextXAlignment.Center
	val.Parent            = block

	return val
end

