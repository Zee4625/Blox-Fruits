-- ============================================================
-- LOGIC: STOP SPECTATE
-- ============================================================
local function stopSpectate()
	isSpectating    = false
	spectatingTarget = nil

	Camera.CameraType    = Enum.CameraType.Custom
	Camera.CameraSubject = LocalPlayer.Character
		and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		or nil

	StatusLabel.Text     = "Not spectating anyone"
	StopBtn.Visible      = false
	StatsPanel.Visible   = false

	-- Reset stats
	FPSValue.Text  = "--"
	PingValue.Text = "--"
	IPValue.Text   = "--"

	-- Reset divider / scroll size
	Divider.Position      = UDim2.new(0, 8, 0, 140)
	PlayersTitle.Position = UDim2.new(0, 8, 0, 144)
	ScrollFrame.Position  = UDim2.new(0, 8, 0, 164)
	MainFrame.Size        = UDim2.new(0, 270, 0, 400)
end

-- ============================================================
-- LOGIC: SPECTATE PLAYER
-- ============================================================
local function spectatePlayer(targetPlayer)
	if targetPlayer == LocalPlayer then return end

	local character = targetPlayer.Character
	if not character then
		StatusLabel.Text = "Player has no character"
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		StatusLabel.Text = "Invalid character"
		return
	end

	isSpectating     = true
	spectatingTarget = targetPlayer

	Camera.CameraType    = Enum.CameraType.Custom
	Camera.CameraSubject = humanoid

	StatusLabel.Text   = "Spectating: " .. targetPlayer.Name
	StopBtn.Visible    = true
	StatsPanel.Visible = true

	-- Expand frame to show stats
	Divider.Position      = UDim2.new(0, 8, 0, 200)
	PlayersTitle.Position = UDim2.new(0, 8, 0, 204)
	ScrollFrame.Position  = UDim2.new(0, 8, 0, 224)
	MainFrame.Size        = UDim2.new(0, 270, 0, 460)
end

