-- ============================================================
RunService.RenderStepped:Connect(function()
	-- FPS
	local now   = tick()
	local delta = now - lastFrameTime
	lastFrameTime = now
	if delta > 0 then
		table.insert(fpsBuffer, 1 / delta)
		if #fpsBuffer > fpsBufferMax then table.remove(fpsBuffer, 1) end
	end

	-- Camera modes
	if isSpectating and spectatingTarget then
		local char = spectatingTarget.Character
		if char then
			local hum  = char:FindFirstChildOfClass("Humanoid")
			local root = char:FindFirstChild("HumanoidRootPart")

			if not hum then stopSpectate() return end

			if selectedCam == "Follow" then
				Camera.CameraType    = Enum.CameraType.Custom
				Camera.CameraSubject = hum

			elseif selectedCam == "First Person" and root then
				local head = char:FindFirstChild("Head")
				if head then
					Camera.CameraType = Enum.CameraType.Scriptable
					Camera.CFrame     = head.CFrame
				end

			elseif selectedCam == "Top Down" and root then
				Camera.CameraType = Enum.CameraType.Scriptable
				Camera.CFrame     = CFrame.new(root.Position + Vector3.new(0, 40, 0),
					root.Position)

			elseif selectedCam == "Fixed" then
				Camera.CameraType    = Enum.CameraType.Custom
				Camera.CameraSubject = hum
			end
		else
			stopSpectate()
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	statTimer   = statTimer + dt
	refreshTimer = refreshTimer + dt

	-- Update live stats every 0.5s
	if statTimer >= 0.5 then
		statTimer = 0

		-- Player count badge
		local plrs = #Players:GetPlayers()
		CountLbl.Text = plrs .. " / " .. Players.MaxPlayers
		serverValues["SPlayers"].Text = tostring(plrs)

		-- FPS calc
		local fps = 0
		if #fpsBuffer > 0 then
			local sum = 0
			for _, v in ipairs(fpsBuffer) do sum = sum + v end
			fps = math.floor(sum / #fpsBuffer)
		end

		-- Ping
		local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())

		-- Update spectate tab stats
		if isSpectating and spectatingTarget then
			liveStats["sFPS"].Text  = fps .. " fps"
			liveStats["sPing"].Text = ping .. " ms"

			local fpsColor = fps >= 55 and C.NEON or (fps >= 30 and C.YELLOW or C.RED)
			local pingColor = ping < 80 and C.NEON or (ping < 150 and C.YELLOW or C.RED)
			liveStats["sFPS"].TextColor3  = fpsColor
			liveStats["sPing"].TextColor3 = pingColor

			local stats = getCharStats(spectatingTarget)
			if stats then
				liveStats["sHealth"].Text = stats.health
				liveStats["sSpeed"].Text  = stats.walkspeed
				liveStats["sJump"].Text   = stats.jumppower
				liveStats["sPos"].Text    = tostring(stats.posY)
				liveStats["sTeam"].Text   = getTeamName(spectatingTarget)
			end

			local jobId = game.JobId
			liveStats["sServerID"].Text = #jobId > 10 and string.sub(jobId, 1, 8) .. ".." or "Studio"
		end

		-- Update player info panel (if selected)
		if selectedPlayer and selectedPlayer.Character then
			local stats = getCharStats(selectedPlayer)
			if stats then
				infoValues["Health"].Text    = stats.health
				infoValues["WalkSpeed"].Text = stats.walkspeed
				infoValues["JumpPower"].Text = stats.jumppower
				infoValues["Position"].Text  = stats.position
			end
			infoValues["FPS"].Text  = fps .. " fps"
			infoValues["Ping"].Text = ping .. " ms"
			infoValues["Team"].Text = getTeamName(selectedPlayer)
		end
	end
end)

