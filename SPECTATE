local function showNotif(msg, isError)
	local f = Instance.new("Frame")
	f.Size             = UDim2.new(1, 0, 0, 36)
	f.BackgroundColor3 = C.BG_PANEL
	f.BorderSizePixel  = 0
	f.BackgroundTransparency = 1
	f.Parent           = NotifHolder

	addCorner(f, 7)
	addStroke(f, isError and C.RED or C.NEON, 1.2)

	local lbl = makeLabel(f, msg, 12, isError and C.RED or C.NEON)
	addPadding(lbl, 10, 10, 0, 0)
	lbl.Size = UDim2.new(1, 0, 1, 0)

	tween(f, {BackgroundTransparency = 0}, 0.2)
	task.delay(3, function()
		tween(f, {BackgroundTransparency = 1}, 0.3)
		task.wait(0.35)
		f:Destroy()
	end)
end

