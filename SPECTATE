local function removePlayerButton(playerName)
	local btn = ScrollFrame:FindFirstChild(playerName)
	if btn then btn:Destroy() end
	if spectatingTarget and spectatingTarget.Name == playerName then
		stopSpectate()
	end
end

local function refreshPlayerList()
	for _, child in ipairs(ScrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			createPlayerButton(player)
		end
	end
end

-- ============================================================
-- STATS UPDATE LOOP
-- ============================================================
local fpsBuffer    = {}
local fpsBufferMax = 20
local lastTime     = tick()

RunService.RenderStepped:Connect(function()
	-- FPS calculation (rolling average)
	local now  = tick()
	local delta = now - lastTime
	lastTime   = now
	if delta > 0 then
		table.insert(fpsBuffer, 1 / delta)
		if #fpsBuffer > fpsBufferMax then
			table.remove(fpsBuffer, 1)
		end
	end

	-- Spectate camera update
	if isSpectating and spectatingTarget then
		local char = spectatingTarget.Character
		if char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid and Camera.CameraSubject ~= humanoid then
				Camera.CameraSubject = humanoid
			end
		else
			stopSpectate()
		end
	end
end)

-- Stats label update every 0.5s
local statTimer = 0
RunService.Heartbeat:Connect(function(dt)
	statTimer = statTimer + dt
	if statTimer < 0.5 then return end
	statTimer = 0

	if not isSpectating or not spectatingTarget then return end

	-- FPS
	if #fpsBuffer > 0 then
		local sum = 0
		for _, v in ipairs(fpsBuffer) do sum = sum + v end
		local avg = math.floor(sum / #fpsBuffer)
		FPSValue.Text = tostring(avg)
		-- color by fps range
		if avg >= 55 then
			FPSValue.TextColor3 = NEON_GREEN
		elseif avg >= 30 then
			FPSValue.TextColor3 = Color3.fromRGB(200, 220, 0)
		else
			FPSValue.TextColor3 = RED_NEON
		end
	end

	-- Ping (of local player only - Roblox does not expose other players' ping)
	local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
	PingValue.Text = ping .. " ms"
	if ping < 80 then
		PingValue.TextColor3 = NEON_GREEN
	elseif ping < 150 then
		PingValue.TextColor3 = Color3.fromRGB(200, 220, 0)
	else
		PingValue.TextColor3 = RED_NEON
	end

	-- IP: Roblox does not expose player IPs to LocalScripts for privacy/security reasons.
	-- This displays the JobId (server instance ID) as the closest available identifier.
	local jobId = game.JobId
	if jobId and #jobId > 0 then
		IPValue.Text = string.sub(jobId, 1, 10) .. "..."
	else
		IPValue.Text = "Studio"
	end
end)

